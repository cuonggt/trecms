{
    "name": "cuonggt/trecms",
    "description": "An opinionated CMS for the Laravel framework.",
    "keywords": [
        "trecms",
        "laravel"
    ],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/cuonggt/trecms/issues",
        "source": "https://github.com/cuonggt/trecms"
    },
    "authors": [
        {
            "name": "Cuong Giang",
            "email": "hi@thaicuong.me"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "cviebrock/eloquent-sluggable": "^11.0",
        "livewire/volt": "^1.4"
    },
    "require-dev": {
        "laravel/pint": "^1.16"
    },
    "autoload": {
        "psr-4": {
            "Cuonggt\\Trecms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cuonggt\\Trecms\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cuonggt\\Trecms\\TrecmsCoreServiceProvider"
            ],
            "aliases": {
                "Trecms": "Cuonggt\\Trecms\\Trecms"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "lint": [
            "@php vendor/bin/phpstan analyse"
        ]
    }
}
